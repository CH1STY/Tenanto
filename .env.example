# MongoDB connection string (Atlas or local replica set)
# - Local Docker Mongo (host, e.g. npm run dev):
#     mongodb://127.0.0.1:27017/tenant_app?directConnection=true&replicaSet=rs0
# - App running inside Docker, connecting to MongoDB on the Docker host:
#     mongodb://host.docker.internal:27017/tenant_app?replicaSet=rs0&directConnection=true
# - Network MongoDB: use a reachable IP/hostname, not localhost.
# - Atlas / online: paste the provided connection string here.
MONGODB_URI=""

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Base URL of the app (used by Auth.js). In Docker this defaults to
# http://localhost:3000 — set your public URL in production.
AUTH_URL="http://localhost:3000"

# Shared website access PIN for logged-out visitors (exactly four digits).
# Set a private value locally and in the PUBLIC_ACCESS_PIN Woodpecker secret.
PUBLIC_ACCESS_PIN=""

# Initial SuperAdmin seed credentials (used by: npm run seed / npm run docker:seed)
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD="
