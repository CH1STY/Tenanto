# MongoDB connection string (Atlas or local replica set)
MONGODB_URI=""

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Base URL of the app
AUTH_URL=""

# Initial SuperAdmin seed credentials (used by: npm run seed)
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD="
